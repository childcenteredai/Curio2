# OpenAI Configuration (BACKEND ONLY - never expose in frontend!)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Model Configuration
OPENAI_CHAT_MODEL=gpt-4.1-2025-04-14
OPENAI_WHISPER_MODEL=whisper-1
# gpt-4o-mini-tts supports the `instructions` tone param and the "coral" voice.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_MAX_TOKENS=500
# Optional: override the TTS tone/vibe instructions (defaults set in app.py).
# OPENAI_TTS_INSTRUCTIONS=

# Database Configuration (for local development)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=curio_db
POSTGRES_USER=curio
POSTGRES_PASSWORD=curio_password

# Frontend URL (for CORS)
VUE_APP_URL=http://localhost:8080

# Application Configuration
PORT=5001
FLASK_ENV=development

# Curio app version: 1 = bubbles on match only; 2 = all bubbles visible (gray), light up on match
CURIO_APP_VERSION=1
